{
  "name": "ai-book-translator",
  "version": "1.0.0",
  "description": "AI-powered book translation platform using local LLMs",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm run dev",
    "install-client": "cd client && npm install",
    "build": "cd client && npm run build",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "epub": "^1.2.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "mammoth": "^1.6.0",
    "natural": "^6.5.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.13.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  }
}
